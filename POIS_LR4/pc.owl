<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://example.org/pois/lr4/pc.owl"
         xmlns="https://example.org/pois/lr4/pc.owl#">

<owl:Ontology rdf:about="https://example.org/pois/lr4/pc.owl"/>

<owl:ObjectProperty rdf:about="#имеет_сокет">
  <rdfs:domain rdf:resource="#Материнская_плата"/>
  <rdfs:range rdf:resource="#Тип_сокета"/>
  <rdfs:comment xml:lang="ru">Тип процессорного разъёма платы.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#требует_сокет">
  <rdfs:domain rdf:resource="#Процессор"/>
  <rdfs:range rdf:resource="#Тип_сокета"/>
  <rdfs:comment xml:lang="ru">Тип разъёма, для которого рассчитан процессор.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#поддерживает_память">
  <rdfs:domain rdf:resource="#Материнская_плата"/>
  <rdfs:range rdf:resource="#Стандарт_памяти"/>
  <rdfs:comment xml:lang="ru">Поколение памяти, поддерживаемое платой.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#имеет_стандарт">
  <rdfs:domain rdf:resource="#Модуль_памяти"/>
  <rdfs:range rdf:resource="#Стандарт_памяти"/>
  <rdfs:comment xml:lang="ru">Поколение памяти конкретного модуля.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#имеет_формат">
  <rdfs:domain rdf:resource="#Материнская_плата"/>
  <rdfs:range rdf:resource="#Форм_фактор"/>
  <rdfs:comment xml:lang="ru">Форм-фактор платы.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#использует_интерфейс">
  <rdfs:domain rdf:resource="#Накопитель"/>
  <rdfs:range rdf:resource="#Интерфейс_накопителя"/>
  <rdfs:comment xml:lang="ru">Интерфейс подключения накопителя.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#включает">
  <rdfs:domain rdf:resource="#Конфигурация_ПК"/>
  <rdfs:range rdf:resource="#Компонент"/>
  <owl:inverseOf rdf:resource="#входит_в"/>
  <rdfs:comment xml:lang="ru">Модель изделия входит в перечень компонентов конфигурации.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#входит_в">
  <rdfs:domain rdf:resource="#Компонент"/>
  <rdfs:range rdf:resource="#Конфигурация_ПК"/>
  <owl:inverseOf rdf:resource="#включает"/>
  <rdfs:comment xml:lang="ru">Обратное отношение к «включает».</rdfs:comment>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#объём_ГБ">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Модуль_памяти"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Компонент">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment xml:lang="ru">Модель аппаратного изделия, которое можно включить в конфигурацию ПК.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Процессор">
  <rdfs:subClassOf rdf:resource="#Компонент"/>
  <rdfs:comment xml:lang="ru">Компонент, выполняющий машинные инструкции.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Настольный_процессор">
  <rdfs:subClassOf rdf:resource="#Процессор"/>
  <rdfs:comment xml:lang="ru">Процессор, предназначенный для настольных компьютеров.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Материнская_плата">
  <rdfs:subClassOf rdf:resource="#Компонент"/>
  <rdfs:comment xml:lang="ru">Основная плата, которая соединяет процессор, память и периферийные устройства.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Плата_ATX">
  <rdfs:subClassOf rdf:resource="#Материнская_плата"/>
  <owl:disjointWith rdf:resource="#Плата_MicroATX"/>
  <rdfs:comment xml:lang="ru">Материнская плата форм-фактора ATX.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Плата_MicroATX">
  <rdfs:subClassOf rdf:resource="#Материнская_плата"/>
  <rdfs:comment xml:lang="ru">Материнская плата форм-фактора microATX.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Плата_AM5_DDR5">
  <rdfs:subClassOf rdf:resource="#Материнская_плата"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Материнская_плата"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#имеет_сокет"/>
          <owl:hasValue rdf:resource="#AM5"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#поддерживает_память"/>
          <owl:hasValue rdf:resource="#DDR5"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment xml:lang="ru">Материнская плата, у которой есть сокет AM5 и поддержка памяти DDR5.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Модуль_памяти">
  <rdfs:subClassOf rdf:resource="#Компонент"/>
  <rdfs:comment xml:lang="ru">Сменный модуль оперативной памяти.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Модуль_DDR4">
  <rdfs:subClassOf rdf:resource="#Модуль_памяти"/>
  <owl:disjointWith rdf:resource="#Модуль_DDR5"/>
  <rdfs:comment xml:lang="ru">Модуль оперативной памяти стандарта DDR4.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Модуль_DDR5">
  <rdfs:subClassOf rdf:resource="#Модуль_памяти"/>
  <rdfs:comment xml:lang="ru">Модуль оперативной памяти стандарта DDR5.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Накопитель">
  <rdfs:subClassOf rdf:resource="#Компонент"/>
  <rdfs:comment xml:lang="ru">Устройство для долговременного хранения данных.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SSD">
  <rdfs:subClassOf rdf:resource="#Накопитель"/>
  <rdfs:comment xml:lang="ru">Накопитель, использующий полупроводниковую память.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SATA_SSD">
  <rdfs:subClassOf rdf:resource="#SSD"/>
  <rdfs:comment xml:lang="ru">Твердотельный накопитель с интерфейсом SATA.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NVMe_SSD">
  <rdfs:subClassOf rdf:resource="#SSD"/>
  <rdfs:comment xml:lang="ru">Твердотельный накопитель, использующий протокол NVMe.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Жёсткий_диск">
  <rdfs:subClassOf rdf:resource="#Накопитель"/>
  <rdfs:comment xml:lang="ru">Накопитель, записывающий данные на вращающиеся магнитные пластины.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Видеокарта">
  <rdfs:subClassOf rdf:resource="#Компонент"/>
  <rdfs:comment xml:lang="ru">Плата расширения с графическим процессором.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Блок_питания">
  <rdfs:subClassOf rdf:resource="#Компонент"/>
  <rdfs:comment xml:lang="ru">Устройство, преобразующее входное питание в напряжения для компонентов ПК.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Система_охлаждения">
  <rdfs:subClassOf rdf:resource="#Компонент"/>
  <rdfs:comment xml:lang="ru">Устройство, отводящее тепло от компонентов ПК.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Воздушный_кулер">
  <rdfs:subClassOf rdf:resource="#Система_охлаждения"/>
  <rdfs:comment xml:lang="ru">Устройство, отводящее тепло через радиатор в поток воздуха.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Жидкостная_СО">
  <rdfs:subClassOf rdf:resource="#Система_охлаждения"/>
  <rdfs:comment xml:lang="ru">Система, которая переносит тепло к радиатору с помощью жидкости.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Корпус">
  <rdfs:subClassOf rdf:resource="#Компонент"/>
  <rdfs:comment xml:lang="ru">Конструкция для размещения и механической защиты компонентов ПК.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Корпус_MidTower">
  <rdfs:subClassOf rdf:resource="#Корпус"/>
  <rdfs:comment xml:lang="ru">Корпус башенной компоновки среднего размера.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Спецификация">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment xml:lang="ru">Техническое обозначение, по которому в модели сопоставляются характеристики изделий.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Тип_сокета">
  <rdfs:subClassOf rdf:resource="#Спецификация"/>
  <rdfs:comment xml:lang="ru">Обозначение механического и электрического соединения процессора с платой.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Стандарт_памяти">
  <rdfs:subClassOf rdf:resource="#Спецификация"/>
  <rdfs:comment xml:lang="ru">Поколение интерфейса оперативной памяти, учитываемое при подборе модуля.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Интерфейс_накопителя">
  <rdfs:subClassOf rdf:resource="#Спецификация"/>
  <rdfs:comment xml:lang="ru">Тип соединения, по которому накопитель обменивается данными с системой.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Интерфейс_SATA">
  <rdfs:subClassOf rdf:resource="#Интерфейс_накопителя"/>
  <rdfs:comment xml:lang="ru">Вариант интерфейса семейства Serial ATA.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Интерфейс_PCIe">
  <rdfs:subClassOf rdf:resource="#Интерфейс_накопителя"/>
  <rdfs:comment xml:lang="ru">Вариант соединения накопителя по шине PCI Express.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Форм_фактор">
  <rdfs:subClassOf rdf:resource="#Спецификация"/>
  <rdfs:comment xml:lang="ru">Обозначение геометрии и схемы крепления платы.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Конфигурация_ПК">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment xml:lang="ru">Описание одного варианта подбора компонентов компьютера.</rdfs:comment>
</owl:Class>

<owl:NamedIndividual rdf:about="#AM5">
  <rdf:type rdf:resource="#Тип_сокета"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#LGA1700">
  <rdf:type rdf:resource="#Тип_сокета"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DDR5">
  <rdf:type rdf:resource="#Стандарт_памяти"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DDR4">
  <rdf:type rdf:resource="#Стандарт_памяти"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ATX">
  <rdf:type rdf:resource="#Форм_фактор"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MicroATX">
  <rdf:type rdf:resource="#Форм_фактор"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PCIe_4_x4">
  <rdf:type rdf:resource="#Интерфейс_PCIe"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SATA_6Gb_s">
  <rdf:type rdf:resource="#Интерфейс_SATA"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MSI_MAG_B650_TOMAHAWK_WIFI">
  <rdf:type rdf:resource="#Плата_ATX"/>
  <имеет_сокет rdf:resource="#AM5"/>
  <поддерживает_память rdf:resource="#DDR5"/>
  <имеет_формат rdf:resource="#ATX"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MSI_PRO_B650M_A_WIFI">
  <rdf:type rdf:resource="#Плата_MicroATX"/>
  <имеет_сокет rdf:resource="#AM5"/>
  <поддерживает_память rdf:resource="#DDR5"/>
  <имеет_формат rdf:resource="#MicroATX"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MSI_PRO_B760M_A_WIFI">
  <rdf:type rdf:resource="#Плата_MicroATX"/>
  <имеет_сокет rdf:resource="#LGA1700"/>
  <поддерживает_память rdf:resource="#DDR5"/>
  <имеет_формат rdf:resource="#MicroATX"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MSI_PRO_B760M_A_WIFI_DDR4">
  <rdf:type rdf:resource="#Плата_MicroATX"/>
  <имеет_сокет rdf:resource="#LGA1700"/>
  <поддерживает_память rdf:resource="#DDR4"/>
  <имеет_формат rdf:resource="#MicroATX"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#AMD_Ryzen_5_7600">
  <rdf:type rdf:resource="#Настольный_процессор"/>
  <требует_сокет rdf:resource="#AM5"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Учебный_DIMM_DDR4">
  <rdf:type rdf:resource="#Модуль_DDR4"/>
  <имеет_стандарт rdf:resource="#DDR4"/>
  <объём_ГБ rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</объём_ГБ>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Учебный_DIMM_DDR5">
  <rdf:type rdf:resource="#Модуль_DDR5"/>
  <имеет_стандарт rdf:resource="#DDR5"/>
  <объём_ГБ rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</объём_ГБ>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Учебный_SSD_M2">
  <rdf:type rdf:resource="#NVMe_SSD"/>
  <использует_интерфейс rdf:resource="#PCIe_4_x4"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Учебный_SSD_25">
  <rdf:type rdf:resource="#SATA_SSD"/>
  <использует_интерфейс rdf:resource="#SATA_6Gb_s"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Учебная_сборка">
  <rdf:type rdf:resource="#Конфигурация_ПК"/>
  <включает rdf:resource="#MSI_PRO_B650M_A_WIFI"/>
  <включает rdf:resource="#AMD_Ryzen_5_7600"/>
  <включает rdf:resource="#Учебный_DIMM_DDR5"/>
  <включает rdf:resource="#Учебный_SSD_M2"/>
</owl:NamedIndividual>

<owl:AllDifferent>
  <owl:distinctMembers rdf:parseType="Collection">
    <rdf:Description rdf:about="#AM5"/>
    <rdf:Description rdf:about="#LGA1700"/>
    <rdf:Description rdf:about="#DDR5"/>
    <rdf:Description rdf:about="#DDR4"/>
    <rdf:Description rdf:about="#ATX"/>
    <rdf:Description rdf:about="#MicroATX"/>
    <rdf:Description rdf:about="#PCIe_4_x4"/>
    <rdf:Description rdf:about="#SATA_6Gb_s"/>
    <rdf:Description rdf:about="#MSI_MAG_B650_TOMAHAWK_WIFI"/>
    <rdf:Description rdf:about="#MSI_PRO_B650M_A_WIFI"/>
    <rdf:Description rdf:about="#MSI_PRO_B760M_A_WIFI"/>
    <rdf:Description rdf:about="#MSI_PRO_B760M_A_WIFI_DDR4"/>
    <rdf:Description rdf:about="#AMD_Ryzen_5_7600"/>
    <rdf:Description rdf:about="#Учебный_DIMM_DDR4"/>
    <rdf:Description rdf:about="#Учебный_DIMM_DDR5"/>
    <rdf:Description rdf:about="#Учебный_SSD_M2"/>
    <rdf:Description rdf:about="#Учебный_SSD_25"/>
    <rdf:Description rdf:about="#Учебная_сборка"/>
  </owl:distinctMembers>
</owl:AllDifferent>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Компонент"/>
    <rdf:Description rdf:about="#Спецификация"/>
    <rdf:Description rdf:about="#Конфигурация_ПК"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
